@* GolBet.Web/Views/Matches/Index.cshtml *@
@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Partidos";
    var current = (MatchStatus?)ViewBag.CurrentStatus;
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>⚽ Cartelera de partidos</h2>
    <a asp-action="Create" class="btn btn-success">+ Nuevo partido</a>
</div>

<!-- Filtros -->
<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Index"
       class="btn btn-sm @(current is null ? "btn-success" : "btn-outline-success")">
        Todos
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.Scheduled"
       class="btn btn-sm @(current == MatchStatus.Scheduled ? "btn-success" : "btn-outline-success")">
        Programados
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.InProgress"
       class="btn btn-sm @(current == MatchStatus.InProgress ? "btn-success" : "btn-outline-success")">
        En juego
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.Finished"
       class="btn btn-sm @(current == MatchStatus.Finished ? "btn-success" : "btn-outline-success")">
        Finalizados
    </a>
</div>

<!-- Tarjetas de partidos -->
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">

    @foreach (var match in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">

                <!-- Equipos -->
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center text-center">

                        <!-- Equipo local -->
                        <div class="w-100">
                            <img src="@(match.HomeTeamCrestUrl ?? "https://placehold.co/60x60/e9ecef/6c757d?text=FC")"
                                 alt="@match.HomeTeamName"
                                 width="60"
                                 height="60"
                                 class="mb-1" />

                            <div class="fw-bold small">
                                @match.HomeTeamName
                            </div>
                        </div>

                        <!-- Resultado -->
                        <div class="px-3 text-nowrap">
                            @if (match.Status == MatchStatus.Finished)
                            {
                                <span class="fs-3 fw-bold">
                                    @match.HomeGoals - @match.AwayGoals
                                </span>
                            }
                            else
                            {
                                <span class="fs-4 text-muted">
                                    vs
                                </span>
                            }
                        </div>

                        <!-- Equipo visitante -->
                        <div class="w-100">
                            <img src="@(match.AwayTeamCrestUrl ?? "https://placehold.co/60x60?text=⚽")"
                                 alt="@match.AwayTeamName"
                                 width="60"
                                 height="60"
                                 class="mb-1" />

                            <div class="fw-bold small">
                                @match.AwayTeamName
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Cuotas -->
                <div class="card-footer">

                    <div class="row g-2 text-center">

                        <!-- Local -->
                        <div class="col">
                            <div class="border rounded py-1">
                                <small class="text-muted d-block">
                                    1 · Local
                                </small>

                                <span class="fw-bold">
                                    @match.HomeOdds.ToString("0.00")
                                </span>
                            </div>
                        </div>

                        <!-- Empate -->
                        <div class="col">
                            <div class="border rounded py-1">
                                <small class="text-muted d-block">
                                    X · Empate
                                </small>

                                <span class="fw-bold">
                                    @match.DrawOdds.ToString("0.00")
                                </span>
                            </div>
                        </div>

                        <!-- Visitante -->
                        <div class="col">
                            <div class="border rounded py-1">
                                <small class="text-muted d-block">
                                    2 · Visitante
                                </small>

                                <span class="fw-bold">
                                    @match.AwayOdds.ToString("0.00")
                                </span>
                            </div>
                        </div>

                    </div>

                    <!-- Ver detalle -->
                  
                    <div class="d-flex gap-2 mt-2">
                        <a asp-action="Detail"
                            asp-route-id="@match.Id"
                            class="btn btn-sm btn-outline-secondary flex-fill">
                            Ver detalle
                        </a>

                        <form asp-action="Deactivate"
                            asp-route-id="@match.Id"
                            method="post"
                            class="flex-fill"
                            onsubmit="return confirm('¿Deseas desactivar este partido?');">
                            <button type="submit"
                                class="btn btn-sm btn-outline-danger w-100">
                                Desactivar
                            </button>
                        </form>
                    </div>


                </div>

            </div>
        </div>
    }

</div>
